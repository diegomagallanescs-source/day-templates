# Copy this file to .env and fill in your own values.
# See README.md for how to get the client ID and calendar ID.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Optional — IANA timezone. Defaults to America/Chicago if omitted.
# VITE_TIMEZONE=America/Chicago
